<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
      <PackageReference Include="HealthMonitoring.Client" />
      <PackageReference Include="OpenIddict.Validation.AspNetCore" />
      <PackageReference Include="OpenIddict.Validation.SystemNetHttp" />
      <PackageReference Include="ClientProxyBase" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
      <PackageReference Include="Lamar" />
      <PackageReference Include="Lamar.Microsoft.DependencyInjection" />
      <PackageReference Include="AspNetCore.HealthChecks.SqlServer" />
      <PackageReference Include="AspNetCore.HealthChecks.UI.Client" />
      <PackageReference Include="AspNetCore.HealthChecks.UI.InMemory.Storage" />
      <PackageReference Include="AspNetCore.HealthChecks.Uris" />
      <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Shared" />
      <PackageReference Include="NLog.Extensions.Logging" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Shared.Results.Web" />
      <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
      <PackageReference Include="Sentry.AspNetCore" />
      <PackageReference Include="TransactionProcessing.ApiDefaults" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FileProcessor.BusinessLogic\FileProcessor.BusinessLogic.csproj" />
    <ProjectReference Include="..\FileProcessor.DataTransferObjects\FileProcessor.DataTransferObjects.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <Target Name="CopyApiXmlDocumentationToOutput" AfterTargets="Build">
    <ItemGroup>
      <ApiXmlDocumentation Include="$(MSBuildProjectDirectory)\..\FileProcessor.DataTransferObjects\bin\$(Configuration)\net10.0\FileProcessor.DataTransferObjects.xml"
                           Condition="Exists('$(MSBuildProjectDirectory)\..\FileProcessor.DataTransferObjects\bin\$(Configuration)\net10.0\FileProcessor.DataTransferObjects.xml')" />
    </ItemGroup>
    <Copy SourceFiles="@(ApiXmlDocumentation)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyApiXmlDocumentationToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ApiXmlDocumentation Include="$(MSBuildProjectDirectory)\..\FileProcessor.DataTransferObjects\bin\$(Configuration)\net10.0\FileProcessor.DataTransferObjects.xml"
                           Condition="Exists('$(MSBuildProjectDirectory)\..\FileProcessor.DataTransferObjects\bin\$(Configuration)\net10.0\FileProcessor.DataTransferObjects.xml')" />
    </ItemGroup>
    <Copy SourceFiles="@(ApiXmlDocumentation)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
